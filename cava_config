[general]
bars = 256
framerate = 30
autosens = 0
sensitivity = 120
lower_cutoff_freq = 20
higher_cutoff_freq = 10000

[input]
method = pipewire
source = auto

[output]
method = raw
raw_target = /dev/stdout
data_format = ascii
bar_delimiter = 59
frame_delimiter = 10
ascii_max_range = 1000
channels = stereo
mono_option = average
reverse = 0

[smoothing]
monstercat = 0
waves = 100
noise_reduction = 0
